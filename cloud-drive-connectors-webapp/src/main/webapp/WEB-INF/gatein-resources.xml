<?xml version="1.0" encoding="UTF-8" ?>
<gatein-resources
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.exoplatform.org/xml/ns/gatein_resources_1_4 http://www.exoplatform.org/xml/ns/gatein_resources_1_4"
        xmlns="http://www.exoplatform.org/xml/ns/gatein_resources_1_4">

  <portlet-skin>
    <application-name>cloud-drive-connectors</application-name>
    <portlet-name>CloudDriveSettingsPortlet</portlet-name>
    <skin-name>Enterprise</skin-name>
    <css-path>/skin/clouddrive.css</css-path>
  </portlet-skin>

  <portlet>
    <name>CloudDriveSettingsPortlet</name>
    <module>
      <load-group>cloudDriveGRP</load-group>    
      <script>
        <path>/js/cloudDriveSettings.bundle.js</path>
      </script>
      <depends>
        <module>extensionRegistry</module>
      </depends>
      <depends>
        <module>eXoVueI18n</module>
      </depends>
      <depends>
        <module>vue</module>
      </depends>
      <depends>
        <module>vuetify</module>
      </depends>
      <depends>
        <module>commonVueComponents</module>
      </depends>
      <depends>
        <module>cloudDriveUtils</module>
      </depends>
      <depends>
        <module>cloudDrives</module>
      </depends>
    </module>
  </portlet>

  <!-- Javascript for Cloud Drive UI support in WCM -->
  <module>
    <name>cloudDriveUtils</name>
    <load-group>cloudDriveGRP</load-group>
    <script>
      <path>/js/utils.js</path>
    </script>
    <depends>
      <module>jquery</module>
    </depends>
    <depends>
      <module>jQueryUI12</module>
      <as>jqueryUI</as>
    </depends>
    <depends>
      <module>jQueryPnotify12</module>
    </depends>
  </module>
  <module>
    <name>cloudDriveTasks</name>
    <load-group>cloudDriveGRP</load-group>
    <script>
      <path>/js/taskstore.js</path>
    </script>
    <depends>
      <module>jquery</module>
    </depends>
    <depends>
      <module>cloudDriveUtils</module>
    </depends>
  </module>
  <module>
    <name>cloudDrives</name>
    <load-group>cloudDriveGRP</load-group>
    <script>
      <path>/js/clouddrives.js</path>
    </script>
    <depends>
      <module>jquery</module>
    </depends>
    <depends>
      <module>cloudDriveUtils</module>
    </depends>
  </module>
  <module>
    <name>cloudDriveDocuments</name>
    <load-group>cloudDriveGRP</load-group>
    <script>
      <path>/js/clouddrive-dms.js</path>
    </script>
    <depends>
      <module>jquery</module>
    </depends>
    <depends>
      <module>cloudDrives</module>
    </depends>
    <depends>
      <module>cloudDriveUtils</module>
    </depends>
    <depends>
      <module>uiRightClickPopupMenu</module>
    </depends>
    <depends>
      <module>uiSimpleView</module>
    </depends>
    <depends>
      <module>uiFileView</module>
    </depends>
    <depends>
      <module>cloudDriveTasks</module>
    </depends>
  </module>

  <module>
    <name>cloudStorage</name>
    <script>
      <minify>false</minify>
      <path>/js/cloudStorage.bundle.js</path>
    </script>
    <depends>
      <module>vue</module>
    </depends>
    <depends>
      <module>eXoVueI18n</module>
    </depends>
    <depends>
      <module>vuetify</module>
    </depends>
    <depends>
      <module>extensionRegistry</module>
    </depends>
  </module>

  <module>
    <name>ConnectorsCloudDriveSettingsExtension</name>
    <load-group>cloudDriveGRP</load-group>
    <script>
      <path>/js/cloudDriveConnectors.bundle.js</path>
    </script>
    <depends>
      <module>extensionRegistry</module>
    </depends>
    <depends>
      <module>eXoVueI18n</module>
    </depends>
    <depends>
      <module>vue</module>
    </depends>
    <depends>
      <module>vuetify</module>
    </depends>
    <depends>
      <module>commonVueComponents</module>
    </depends>
    <depends>
      <module>cloudDrive_gdrive</module>
    </depends>
    <depends>
      <module>cloudDrive_onedrive</module>
    </depends>
  </module>

  <!-- Javascript for Cloud Drive support of Google Drive -->
  <module>
    <name>cloudDrive_gdrive</name>
    <script>
      <path>/js/gdrive/clouddrive-gdrive.js</path>
    </script>
    <depends>
      <module>jquery</module>
    </depends>
    <depends>
      <module>cloudDriveUtils</module>
    </depends>
  </module>

  <!-- Javascript for Cloud Drive support of One Drive -->
  <module>
    <name>cloudDriveSocketIO</name>
    <load-group>cloudDriveOnedriveGRP</load-group>
    <script>
      <minify>false</minify>
      <adapter>
        (function() {
        <include>/js/onedrive/socket.io.js</include>
        return {
        io: io
        };
        })();
      </adapter>
    </script>
  </module>

  <module>
    <name>cloudDrive_onedrive</name>
    <load-group>cloudDriveOnedriveGRP</load-group>
    <script>
      <path>/js/onedrive/clouddrive-onedrive.js</path>
    </script>
    <depends>
      <module>jquery</module>
    </depends>
    <depends>
      <module>cloudDriveDocuments</module>
    </depends>
    <depends>
      <module>cloudDriveUtils</module>
    </depends>
    <depends>
      <module>cloudDriveSocketIO</module>
    </depends>
  </module>
</gatein-resources>